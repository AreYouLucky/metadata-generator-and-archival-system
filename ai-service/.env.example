# Under Docker Compose, INTERNAL_SHARED_SECRET, LARAVEL_CALLBACK_BASE, REDIS_URL,
# CELERY_RESULT_URL, STORAGE_ROOT and REPLAY_GUARD are set by docker-compose.yml
# (the secret comes from the root .env so both sides always match).
# Copy this file to ai-service/.env for provider keys and model choices.

INTERNAL_SHARED_SECRET=change-me
LARAVEL_CALLBACK_BASE=http://web:8000
STORAGE_ROOT=/data/storage
REDIS_URL=redis://redis:6379/1
CELERY_RESULT_URL=redis://redis:6379/2
REPLAY_GUARD=redis

TRANSCRIPTION_PROVIDER=openai      # openai | local | assemblyai
LOCAL_WHISPER_MODEL=small
LLM_PROVIDER=anthropic             # anthropic | openai
LLM_MODEL=                         # set to a current model id
VISION_MODEL=                      # vision-capable model id
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
HF_TOKEN=                          # pyannote

FRAME_INTERVAL_SEC=10
MAX_FRAMES=60
PROXY_MAX_HEIGHT=1080

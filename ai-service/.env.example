# Under Docker Compose, INTERNAL_SHARED_SECRET, LARAVEL_CALLBACK_BASE, REDIS_URL,
# CELERY_RESULT_URL, STORAGE_ROOT and REPLAY_GUARD are set by docker-compose.yml
# (the secret comes from the root .env so both sides always match).
# Copy this file to ai-service/.env for provider keys and model choices.

INTERNAL_SHARED_SECRET=change-me
LARAVEL_CALLBACK_BASE=http://host.docker.internal:8000
STORAGE_ROOT=/data/storage
REDIS_URL=redis://redis:6379/1
CELERY_RESULT_URL=redis://redis:6379/2
REPLAY_GUARD=redis

TRANSCRIPTION_PROVIDER=local       # local | openai | assemblyai (openai and assemblyai upload the audio)
LOCAL_WHISPER_MODEL=large-v3-turbo   # large-v3: a little more accurate, several times slower
LOCAL_WHISPER_DEVICE=cuda          # cuda | cpu (cpu needs no docker-compose.gpu.yml)
LOCAL_WHISPER_COMPUTE_TYPE=int8_float16   # int8 on CPU
LOCAL_WHISPER_BATCH_SIZE=8         # chunks decoded at once; lower if CUDA runs out of memory, 1 = off
LLM_PROVIDER=openai                # openai (anthropic: not built yet)
LLM_MODEL=gpt-6.2-sol              # final metadata call (OpenAI docs, 2026-11-21)
LLM_LIGHT_MODEL=gpt-6-luna         # map step for long transcripts
LLM_REASONING_EFFORT=low           # gpt-6.2-sol accepts low and up
LLM_LIGHT_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_TRANSCRIPT_TOKENS=60000    # above this, summarise in parts first
VISION_MODEL=gpt-6-luna            # frame descriptions (cheap model, low-detail images)
VISION_BATCH_FRAMES=8              # frames per vision call
VISION_IMAGE_SIZE=512              # longest side of the images sent, in pixels
LLM_CHAT_MODEL=gpt-6.2-sol         # chat with the video (Phase 7): answers only from Laravel's tools
LLM_CHAT_REASONING_EFFORT=low
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small   # transcript search; the size comes from Laravel (EMBEDDING_DIMENSIONS)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODELS=assemblyai-stt-3-7,universal-2   # first preferred, the rest fallbacks

# Speaker identification (Phase 6): pyannote on this machine, or AssemblyAI (uploads the audio)
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1   # accept its terms on Hugging Face
DIARIZATION_DEVICE=cpu             # cuda sends it to the GPU queue (needs a CUDA build of torch)
# Hugging Face token for pyannote (an inline comment after an empty value becomes the value)
HF_TOKEN=

# URL import (Phase 6, yt-dlp): site extractors only; true also allows direct file links
IMPORT_ALLOW_GENERIC=false
IMPORT_MAX_HEIGHT=1080

# Visual analysis (Phase 5): key frames at scene starts plus one every FRAME_INTERVAL_SEC
FRAME_INTERVAL_SEC=10
MAX_FRAMES=60                      # the interval grows for long videos
SCENE_THRESHOLD=27                 # PySceneDetect content threshold; lower finds more cuts
OCR_LANGUAGES=en,tl                # EasyOCR codes; tl = Tagalog/Filipino
OBJECT_MODEL=yolo11n.pt            # Ultralytics weights (AGPL-3.0), downloaded on first use
PROXY_MAX_HEIGHT=1080

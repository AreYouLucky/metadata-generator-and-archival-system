APP_NAME="Metadata Generator and Archival System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mgas
DB_USERNAME=mgas
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets). Generate with: php artisan reverb:install, or any random strings.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http
# Host port Docker publishes Reverb on; keep VITE_REVERB_PORT the same
REVERB_HOST_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Uploaded media: storage/app/media by default (mounted into the AI containers).
# MEDIA_ROOT=

# AI service. Generate the secret with: php -r "echo bin2hex(random_bytes(32));"
AI_SERVICE_URL=http://127.0.0.1:8001
# Where the AI worker calls Laravel back. Default: http://host.docker.internal:8000
# (Laravel on the host). Use http://web:8000 with --profile docker-laravel.
# LARAVEL_CALLBACK_BASE=
INTERNAL_SHARED_SECRET=

# Limits and archival settings (config/archive.php)
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=180
MAX_BATCH_SIZE=20
EMBEDDING_DIMENSIONS=1536
ACCESSION_NUMBER_FORMAT="ACC-{year}-{seq:5}"
FIXITY_CHECK_INTERVAL_DAYS=90
PUBLIC_CATALOGUE_REQUIRES_LOGIN=false
ALLOW_PUBLIC_REGISTRATION=true
ENCODER_DAILY_PROCESSING_MINUTES=120

# First admin (database/seeders/UserSeeder.php). ADMIN_PASSWORD is required
# outside local/testing; locally it falls back to "password".
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
